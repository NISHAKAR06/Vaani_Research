# Groq Cloud API Credentials
# Obtain your free API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model Configuration
GROQ_MODEL=llama-3.3-70b-versatile
# Alternative: llama-3.1-8b-instant

# Service Endpoints
API_HOST=0.0.0.0
API_PORT=8000
STANDIN_URL=http://127.0.0.1:8001

# System Resilience & Limits Defaults
DEFAULT_MAX_CONCURRENCY=5
DEFAULT_QUEUE_CAPACITY=20
DEFAULT_REQUEST_TIMEOUT_SECONDS=15.0
DEFAULT_RPM_BUDGET=30
DEFAULT_DAILY_REQUEST_BUDGET=1000

